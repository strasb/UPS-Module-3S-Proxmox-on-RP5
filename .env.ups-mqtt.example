# Example environment file for ups-mqtt.service
# Copy this file to /etc/default/ups-mqtt and adjust the values for your setup.

MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USERNAME=homeassistant
MQTT_PASSWORD=your_password
MQTT_TOPIC=ups/rpi5
POLL_INTERVAL=15
I2C_BUS=1
INA219_ADDR=0x41
HA_DISCOVERY=1
HA_DISCOVERY_PREFIX=homeassistant
DEVICE_ID=
