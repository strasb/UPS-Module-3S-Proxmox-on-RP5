[Unit]
Description=Waveshare UPS 3S MQTT Publisher
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/root/UPS-Module-3S-Proxmox-on-RP5
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/default/ups-mqtt
ExecStart=/root/UPS-Module-3S-Proxmox-on-RP5/.venv/bin/python /root/UPS-Module-3S-Proxmox-on-RP5/ups_mqtt_publisher.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
